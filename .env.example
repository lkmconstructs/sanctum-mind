# Postgres the service owns. Supabase works with the same string.
# migrate and seed-keys need an admin URL; http and stdio need the sanctum_app login.
DATABASE_URL=postgresql://postgres@localhost:5432/sanctum_mind
# HTTP listen port (default 8002)
PORT=8002
# HTTP listen address (default 127.0.0.1, loopback only). 0.0.0.0 listens on every interface; plain HTTP, put TLS in front.
HOST=127.0.0.1
# HTTP connection cap (default 256).
MAX_CONNECTIONS=256
# stdio only: the construct's bearer key. Re-checked on every tool call.
SANCTUM_BEARER=
# Embeddings for retrieval. EMBEDDER: local (default, fastembed bge-small-en-v1.5 on CPU), http, or none.
# With none (or any embedder failure) retrieval degrades to full text search.
EMBEDDER=local
# http embedder only: an OpenAI-compatible embeddings endpoint (POST {"input":[...]} -> {"data":[{"embedding":[...]}]}), 384 dimensions.
EMBED_URL=
# http embedder only: sent as a bearer token when set.
EMBED_API_KEY=
# local embedder only: where model files are cached (default ./.embed-cache).
EMBED_CACHE_DIR=./.embed-cache
# Identity cooling period in whole hours (default 24; 0 for solo use). A rewrite or retirement of a core and a vow break take effect
# this long after the mind declares them. The http, stdio and daemon commands refuse to start on an invalid value.
IDENTITY_COOLING_HOURS=24
