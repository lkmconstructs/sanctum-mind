# Postgres the service owns. Supabase works with the same string.
# migrate and seed-keys need an admin URL; http and stdio need the sanctum_app login.
DATABASE_URL=postgresql://postgres@localhost:5432/sanctum_mind
# HTTP listen port (default 8002)
PORT=8002
# HTTP listen address (default 127.0.0.1, loopback only). 0.0.0.0 listens on every interface; plain HTTP, put TLS in front.
HOST=127.0.0.1
# HTTP connection cap (default 256).
MAX_CONNECTIONS=256
# stdio only: the construct's bearer key. Re-checked on every tool call.
SANCTUM_BEARER=
# Embeddings for retrieval. EMBEDDER: local (default, fastembed bge-small-en-v1.5 on CPU), http, or none.
# With none (or any embedder failure) retrieval degrades to full text search.
EMBEDDER=local
# http embedder only: an OpenAI-compatible embeddings endpoint (POST {"input":[...]} -> {"data":[{"embedding":[...]}]}), 384 dimensions.
EMBED_URL=
# http embedder only: sent as a bearer token when set.
EMBED_API_KEY=
# local embedder only: where model files are cached (default ./.embed-cache).
EMBED_CACHE_DIR=./.embed-cache
# Identity cooling period in whole hours (default 24; 0 for solo use). A rewrite or retirement of a core and a vow break take effect
# this long after the mind declares them. The http, stdio and daemon commands refuse to start on an invalid value.
IDENTITY_COOLING_HOURS=24
# The extractor (optional, off until the operator enables it per mind: sanctum-mind extractor enable --mind <id>).
# Days a proposal waits for the mind before it expires (default 14).
EXTRACTOR_TTL_DAYS=14
# Days after a proposal expired before the same sources may be proposed again, and then only if the score rose (default 60).
EXTRACTOR_REPROPOSE_DAYS=60
# Days back that new memories are compared with older live ones, for links and patterns across days (1 to 365, default 30).
EXTRACTOR_LOOKBACK_DAYS=30
# Candidates kept per kind per run, before reranking (1 to 500, default 50).
EXTRACTOR_MAX_CANDIDATES=50
# Reranker for the extractor's candidates. RERANKER: none (default; candidates are scored on cosine and the other features), http, or local.
# The daemon refuses to start on an unknown value, or on http without a valid RERANK_URL.
RERANKER=none
# http reranker only: sends the mind's own words (up to 240 characters of one source, 600 of each other) to this URL on every run, so
# trust it like a sink. No user:pass@ in it (use RERANK_API_KEY); over plain http:// only for loopback. POST {"query": "...", "documents": ["..."]} -> {"scores": [0.9, ...]}, one per document. 10 second timeout, redirects refused.
RERANK_URL=
# http reranker only: sent as a bearer token when set.
RERANK_API_KEY=
# local reranker only: where model files are cached (default ./.rerank-cache). Needs the optional package: npm install --no-save @huggingface/transformers
RERANK_CACHE_DIR=./.rerank-cache
