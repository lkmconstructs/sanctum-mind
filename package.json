{
  "name": "sanctum-mind",
  "version": "0.2.0",
  "description": "Persistent memory and identity for AI minds, served as MCP tools on Postgres.",
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-memory",
    "persistent-memory",
    "postgres",
    "pgvector",
    "event-sourcing",
    "continuity"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/lkmconstructs/sanctum-mind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkmconstructs/sanctum-mind.git"
  },
  "bugs": {
    "url": "https://github.com/lkmconstructs/sanctum-mind/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sanctum-mind": "dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "CHANGELOG.md",
    "UPGRADING.md",
    "SECURITY.md",
    "ACKNOWLEDGEMENTS.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "start": "tsx src/cli.ts",
    "dev:http": "tsx src/cli.ts http",
    "dev:stdio": "tsx src/cli.ts stdio",
    "prepublishOnly": "npm run typecheck && npm run build && node -e \"require('fs').existsSync('lkm') && process.exit(1)\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastembed": "3.0.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
